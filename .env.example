# ── Telegram API credentials ──────────────────────────────────────────────────
# Отримати на https://my.telegram.org → "API development tools"
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# Номер телефону акаунту (формат: +380XXXXXXXXX)
TG_PHONE=+380XXXXXXXXX

# Ім'я файлу сесії (буде збережено в ./data/)
TG_SESSION=collector

# ── Збір ──────────────────────────────────────────────────────────────────────
# Список каналів для збору, через кому (@ або t.me/...)
TG_CHANNELS=ukrainska_pravda_fast,ukr_pravda_life,ukrinform_ua

# Скільки повідомлень забирати за один прогін (cursor batch)
BATCH_SIZE=100

# Пауза між каналами, секунди (politeness)
CHANNEL_DELAY=2.0

# Пауза між повідомленнями в batch, секунди
MESSAGE_DELAY=0.05

# Максимум resolve на день на акаунт (захист від FloodWait за обсягом)
RESOLVE_BUDGET_PER_DAY=60

# ── Зберігання ────────────────────────────────────────────────────────────────
# Шлях до SQLite-файлу
DB_PATH=./data/collector.db

# Теки для медіафайлів (якщо порожньо — медіа не завантажуються)
MEDIA_DIR=

# ── Проксі (опційно) ──────────────────────────────────────────────────────────
# SOCKS5-проксі для Telethon (формат: socks5://user:pass@host:port)
# TG_PROXY=socks5://user:pass@127.0.0.1:1080
TG_PROXY=
